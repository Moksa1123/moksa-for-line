msgstr "目前是沙盒模式，不會有實際金流。正式上線前請關閉。"

#: src/Admin/AdminModule.php:513
#: views/settings.php:700
msgid "Credentials are encrypted at rest"
msgstr "憑證已加密儲存"

#: src/Admin/AdminModule.php:514
