msgstr "AI 回覆已開啟，但所選的 AI 服務在這個站台上並不存在。"

#: src/Admin/AdminModule.php:483
msgid "The AI service is present but has no provider connected yet, so it cannot answer anything."
msgstr "AI 服務在，但還沒有接上任何供應商，所以目前什麼都答不出來。"

#: src/Admin/AdminModule.php:488
msgid "AI provider available"
msgstr "AI 服務可用"

#: src/Admin/AdminModule.php:497
msgid "LINE Pay credentials present"
msgstr "已填入 LINE Pay 憑證"

#: src/Admin/AdminModule.php:498
msgid "Add the LINE Pay Channel ID and Channel Secret."
msgstr "請填入 LINE Pay 的 Channel ID 與 Channel Secret。"

#: src/Admin/AdminModule.php:504
msgid "LINE Pay is in production mode"
msgstr "LINE Pay 已切換到正式環境"

#: src/Admin/AdminModule.php:505
