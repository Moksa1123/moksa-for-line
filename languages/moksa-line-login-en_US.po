#: templates/admin/settings-general.php:14
msgid "頻道 ID"
msgstr "Channel ID"

#: templates/admin/settings-general.php:19
msgid "請輸入 LINE Login Channel 的 Channel ID。"
msgstr "Enter the Channel ID from LINE Login Channel."

#: templates/admin/settings-general.php:30
msgid "請輸入 LINE Login Channel 的 Channel Secret。"
msgstr "Enter the Channel Secret from LINE Login Channel."

#: templates/admin/settings-general.php:36
msgid "LIFF ID (選填)"
msgstr "LIFF ID (Optional)"

#: templates/admin/settings-general.php:41
msgid "用於在 LINE 內部瀏覽器中自動登入。請在 LINE Developers Console 中建立 LIFF App，並將 LIFF ID 貼於此處。"
msgstr "Used for automatic login in LINE's internal browser. Create a LIFF App in LINE Developers Console and paste the LIFF ID here."

#: templates/admin/settings-general.php:51
msgid "請複製此網址並貼到 LINE Developers Console 的 \"Callback URL\" 欄位中。"
msgstr "Copy this URL and paste it into the \"Callback URL\" field in LINE Developers Console."

#: templates/admin/settings-general.php:57
msgid "自動註冊"
msgstr "Auto Registration"

#: templates/admin/settings-general.php:62
msgid "當新的 LINE 使用者登入時，自動為其建立 WordPress 帳號。"
msgstr "Automatically create a WordPress account when a new LINE user logs in."

#: templates/admin/settings-general.php:68
msgid "同步個人資料"
msgstr "Sync Profile"

#: templates/admin/settings-general.php:73
msgid "每次登入時，自動同步 LINE 的顯示名稱和頭像到 WordPress 個人資料。"
msgstr "Automatically sync LINE display name and avatar to WordPress profile on each login."

#: templates/admin/settings-general.php:79
msgid "登入後跳轉"
msgstr "Redirect After Login"

#: templates/admin/settings-general.php:84
msgid "登入成功後要跳轉的頁面路徑 (例如: /my-account)。留空則跳轉回原頁面。"
msgstr "Page path to redirect to after successful login (e.g., /my-account). Leave empty to redirect back to the original page."

#: templates/admin/settings-general.php:90
msgid "n8n Webhook 網址"
msgstr "n8n Webhook URL"

#: templates/admin/settings-general.php:95
msgid "將所有 LINE Webhook 事件轉發到此 n8n Webhook URL (選填)。"
msgstr "Forward all LINE Webhook events to this n8n Webhook URL (optional)."

#: templates/admin/settings-general.php:101
msgid "儲存設定"
msgstr "Save Settings"

#: templates/admin/settings-messaging.php:14
msgid "頻道存取權杖"
msgstr "Channel Access Token"

#: templates/admin/settings-messaging.php:18
msgid "請輸入 LINE Developers Console 中的 Long-lived Channel Access Token。"
msgstr "Enter the Long-lived Channel Access Token from LINE Developers Console."

#: templates/admin/settings-messaging.php:29
msgid "用於 Webhook 驗證的 Channel Secret (如果與 Login Channel Secret 不同)。"
msgstr "Channel Secret for Webhook verification (if different from Login Channel Secret)."

#: templates/admin/settings-messaging.php:37
msgid "請將此網址設定到 LINE Developers Console 的 \"Messaging API\" 頁籤中的 Webhook URL。"
msgstr "Set this URL in the Webhook URL field under the \"Messaging API\" tab in LINE Developers Console."

#: templates/admin/settings-messaging.php:43
msgid "加好友連結"
msgstr "Add Friend Link"

#: templates/admin/settings-messaging.php:48
msgid "讓使用者將您的官方帳號加為好友的連結 (例如: https://line.me/R/ti/p/@yourid)。"
msgstr "Link for users to add your official account as a friend (e.g., https://line.me/R/ti/p/@yourid)."

#: templates/admin/settings-messaging.php:54
msgid "訂單通知延遲"
msgstr "Order Notification Delay"

#: templates/admin/settings-messaging.php:58
msgid "秒"
msgstr "seconds"

#: templates/admin/settings-messaging.php:59
msgid "延遲發送訂單狀態通知，以確保第三方物流外掛已更新追蹤號碼。"
msgstr "Delay sending order status notifications to ensure third-party shipping plugins have updated tracking numbers."

#: templates/admin/settings-messaging.php:60
msgid "例如: <strong>%s</strong> 代表 10 分鐘。設為 0 則立即發送。"
msgstr "For example: <strong>%s</strong> represents 10 minutes. Set to 0 to send immediately."

